    <!-- Setup checklist -->
    <string name="editor_setup_label">SETUP</string>
    <string name="editor_setup_banner">Only one app may hold the accessory channel. Discovery needs the watch connected, so it comes first — then the stock plugin has to let the channel go by losing its Nearby devices access.</string>
    <string name="editor_setup_banner_legacy">Only one app may hold the accessory channel. Discovery needs the watch connected, so it comes first — then the stock plugin has to let the channel go. This phone has no Nearby devices switch for it, so step 4 needs a tool that can disable the plugin.</string>
    <string name="editor_setup_step1_title">Connect the watch in its companion app</string>
    <string name="editor_setup_step1_why">Hands pairing back to the stock app, then return here.</string>
    <string name="editor_setup_step1_done">Companion app and plugin found</string>
    <string name="editor_setup_step1_done_plugin_only">Watch plugin found, no companion app</string>
    <string name="editor_setup_step1_done_companion_only">Companion app found, no watch plugin</string>
    <string name="editor_setup_step1_done_agent_only">An app that can reach the watch was found</string>
    <string name="editor_setup_step2_title">Grant FitFace Nearby devices access</string>
    <string name="editor_setup_step2_why">Android asks for this before any app may use the accessory channel.</string>
    <string name="editor_setup_step2_done">Granted</string>
    <string name="editor_setup_step3_title">Discover the watch-face and OTA peers</string>
    <string name="editor_setup_step3_why">Needs the watch connected, so the plugin\'s access has to be ON for this step — turn it back on if you have already revoked it.</string>
    <string name="editor_setup_step3_why_legacy">Needs the watch connected, so the plugin has to be enabled and holding it — turn it back on first if you disabled it for an earlier attempt.</string>
    <string name="editor_setup_step3_done">Both peers cached — they stay cached while the watch does</string>
    <string name="editor_setup_step4_title">Let the plugin release the channel</string>
    <string name="editor_setup_step4_why">Turn the plugin\'s Nearby devices access off. Return here after Android applies the change.</string>
    <string name="editor_setup_step4_why_legacy">No Nearby devices switch on this Android version — the plugin has to be disabled instead. Freeze it with Hail in its Shizuku working mode, or disable it over ADB, then confirm below. Put it back after the attempt.</string>
