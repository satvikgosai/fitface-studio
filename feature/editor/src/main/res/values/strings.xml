    <string name="editor_setup_label">SETUP</string>
    <string name="editor_setup_banner">Only one app may hold the accessory channel. Discovery needs the watch connected, so it comes first — then the stock plugin has to let the channel go, which either disconnecting the watch or revoking the plugin\'s Nearby access will do.</string>
