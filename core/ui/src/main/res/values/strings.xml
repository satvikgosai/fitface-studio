<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared component copy. Names are prefixed `ui_` because library-module resources are
  merged into one table at the app level, where a bare name colliding with a feature
  module's would be silently overridden rather than reported.
-->
<resources>
    <!--
      What a numbered style is called, shared by the editor and the library so the two
      cannot word the same colourway differently. `styleLabel` applies the one-based offset;
      the argument here is already the number the reader sees. The always-on display is not
      a numbered style and is named in words by the module that shows it.
    -->
    <string name="ui_style_label">Style %1$d</string>

    <!-- FitTopBar's back affordance is the "‹" glyph, so its label lives here. -->
    <string name="ui_back">Back</string>

    <!-- StatusBanner's default badge, one per FitStatus. -->
    <string name="ui_status_pass">OK</string>
    <string name="ui_status_warning">WARN</string>
    <string name="ui_status_fail">FAIL</string>

    <!--
      The one action in either top bar. The control is a glyph, so this carries the whole
      label for TalkBack. It is also what both layout tests find the button by and what the
      catalogue-unavailable copy in :feature:library points the reader at, so the wording is
      load-bearing in three places.
    -->
    <string name="ui_app_menu_a11y">More options</string>
    <string name="ui_app_menu_about">About this app</string>
    <string name="ui_app_menu_update">Check for update</string>

    <!-- The pasteable bug report, the first entry in that menu. -->
    <string name="ui_diagnostics_action">Report a problem</string>
    <string name="ui_diagnostics_title">@string/ui_diagnostics_action</string>
    <!--
      Says what the report holds, and stops. It used to end by listing what it leaves out —
      device identifiers, the watch's Bluetooth address, the images you picked — which reads
      as an inventory of things the app is holding back rather than things it never collects.
      Do not reintroduce that list. The allowlist in DiagnosticsReporter is where the
      exclusions belong, and it is documented there for whoever maintains it.
    -->
    <string name="ui_diagnostics_blurb">Copy this and paste it into your bug report. It holds the app version, this phone\'s Android version and model, its language setting, and what the app has done this session — nothing identifiable.</string>
    <string name="ui_diagnostics_copy">Copy</string>
    <string name="ui_diagnostics_close">Close</string>
    <string name="ui_diagnostics_copied">Report copied</string>
    <!--
      About. Says what the app is and what version is running — a sideloaded app has
      nowhere else to put either. The second string is the short form of NOTICE.md and is
      not optional; it names no vendor and no store, per the naming rule in CONTRIBUTING.md.
    -->
    <string name="ui_about_title">@string/ui_app_menu_about</string>
    <!--
      Two sentences, and it is worth keeping them to two. The whole dialog has to fit the
      height a landscape phone leaves an AlertDialog — about eleven lines — and this
      paragraph is the biggest thing competing for it. The version and the link are the two
      things the dialog exists for, so prose is what gives way when something has to.
    -->
    <string name="ui_about_what_it_is">Edit a watch face on your phone and send it to a paired watch. Every edit is checked before sending.</string>
    <!--
      One line on purpose. The long form is NOTICE.md, which the link below reaches, and a
      dialog is the wrong place to restate it — a wall of disclaimer stops being read at all,
      which is the opposite of what it is for. What must survive any further trimming is the
      words "independent" and "not affiliated": everything else here is context.
    -->
    <string name="ui_about_independent">Independent, experimental, and for personal use — not affiliated with any device or platform vendor.</string>
    <string name="ui_about_version">Version %1$s</string>

    <!--
      The project page: source, full notices, releases. It has no label line of its own —
      a GitHub address in an About dialog needs no introducing, and the line it would take
      is the line the version needs to stay on screen in landscape. The label survives for
      a screen reader as the link's own description.
    -->
    <string name="ui_about_source_a11y">Project page: source, notices and releases</string>
    <string name="ui_about_source_url" translatable="false">https://github.com/satvikgosai/fitface-studio</string>

    <!--
      The update flow. Two things the copy has to be honest about, because both surprise
      people: closing the dialog does not stop a download, and installing hands the file to
      Android, which asks its own question and then replaces this app.
    -->
    <string name="ui_update_title">App update</string>
    <string name="ui_update_checking">Checking for updates…</string>
    <string name="ui_update_up_to_date">You’re up to date.</string>
    <string name="ui_update_available">Version %1$s available · %2$s MB</string>
    <string name="ui_update_downloading">Downloading %1$s. This continues if you close the dialog.</string>
    <string name="ui_update_progress">%1$d%% of %2$s MB</string>
    <string name="ui_update_ready">Version %1$s is downloaded and checked. Android will ask you to confirm installation.</string>
    <string name="ui_update_installing">Android is installing the update. This app closes if installation succeeds.</string>
    <string name="ui_update_failed_fallback">The update could not be checked.</string>
    <string name="ui_update_installed">Installed: %1$s</string>
    <string name="ui_update_download">Download</string>
    <string name="ui_update_install">Install</string>
    <string name="ui_update_cancel">@string/ui_cancel</string>
    <string name="ui_update_try_again">@string/ui_try_again</string>
    <string name="ui_update_allow_installs">Allow installs</string>
    <string name="ui_cancel">Cancel</string>
    <string name="ui_try_again">Try again</string>
    <string name="ui_project_name">Project name</string>
    <string name="ui_rename_project">Rename project</string>
    <string name="ui_delete">Delete</string>
    <string name="ui_delete_project_title">Delete this project?</string>
    <string name="ui_delete_project_message">%1$s and every edit saved in it will be removed from this device. The watch face itself can be downloaded again.</string>
    <string name="ui_project_duplicated">Duplicated as “%1$s”</string>
    <string name="ui_not_editable">Not editable</string>
    <string name="ui_always_on_display">Always-on display</string>
    <string name="ui_widget_number">Widget #%1$d</string>
    <string name="ui_clear_selection">Clear</string>
    <string name="ui_details_expand">Expand %1$s</string>
    <string name="ui_details_collapse">Collapse %1$s</string>
    <string name="ui_details_expanded">Expanded</string>
    <string name="ui_details_collapsed">Collapsed</string>
</resources>
